#include <stdio.h>
#include <string.h>
char* longestPalindrome(char* s) {
    int len = strlen(s); 
    if (len < 1) return "";
    int start = 0;
    int maxLen = 1;
    for (int i = 0; i < len; i++) {
        int L = i; 
        int R = i; 
        while (L >= 0 && R < len && s[L] == s[R]) {
            int currentLen = R - L + 1;
            if (currentLen > maxLen) {
                start = L;
                maxLen = currentLen;
            }
            L--;
            R++;
        }
        L = i; 
        R = i + 1;
        while (L >= 0 && R < len && s[L] == s[R]) {
            int currentLen = R - L + 1;
            if (currentLen > maxLen) {
                start = L;
                maxLen = currentLen;
            }
            L--;
            R++;
        }
    }
    s[start + maxLen] = '\0';
    return &s[start];
}
