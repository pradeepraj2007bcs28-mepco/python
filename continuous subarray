#include <stdio.h>
#include <stdlib.h>
long long continuousSubarrays(int* nums, int numsSize) {
    long long totalSubarrays = 0;
    int left = 0;
    int min_val = nums[0];
    int max_val = nums[0];
    for (int right = 0; right < numsSize; right++) {
        if (nums[right] < min_val) min_val = nums[right];
        if (nums[right] > max_val) max_val = nums[right];
        if (max_val - min_val > 2) {
            left = right;
            min_val = nums[right];
            max_val = nums[right];
            while (left > 0) {
                int prev_val = nums[left - 1];
                int new_min = prev_val < min_val ? prev_val : min_val;
                int new_max = prev_val > max_val ? prev_val : max_val;
                if (new_max - new_min <= 2) {
                    left--;
                    min_val = new_min;
                    max_val = new_max;
                } else {
                    break;
                }
            }
        }
        totalSubarrays += (long long)(right - left + 1);
    }
    return totalSubarrays;
}

