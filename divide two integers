#include <stdio.h>
#include <math.h>
int divide(int dividend, int divisor) {
    if (dividend == INT_MIN && divisor == -1) {
        return INT_MAX;
    }
    long long num = dividend;
    long long den = divisor;
    int isNegative = 0;
    if ((num < 0 && den > 0) || (num > 0 && den < 0)) {
        isNegative = 1;
    }
    if (num < 0) num = -num;
    if (den < 0) den = -den;
    int quotient = 0;
    while (num >= den) {
        num -= den; 
        quotient++; 
    }
    if (isNegative) {
        return -quotient;
    }
    return quotient;
}
