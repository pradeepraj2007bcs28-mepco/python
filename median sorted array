#include <stdio.h>
double findMedianSortedArrays(int* nums1, int nums1Size, int* nums2, int nums2Size) {
    int merged[2000]; 
    int i = 0, j = 0, k = 0;
    while (i < nums1Size && j < nums2Size) {
        if (nums1[i] < nums2[j]) {
            merged[k] = nums1[i];
            i++;
        } else {
            merged[k] = nums2[j];
            j++;
        }
        k++;
    }
    while (i < nums1Size) {
        merged[k] = nums1[i];
        i++;
        k++;
    }
    while (j < nums2Size) {
        merged[k] = nums2[j];
        j++;
        k++;
    }
    int totalSize = nums1Size + nums2Size;
    int mid = totalSize / 2;
    if (totalSize % 2 != 0) {
        return (double)merged[mid];
    } else {
        return (merged[mid - 1] + merged[mid]) / 2.0;
    }
}
