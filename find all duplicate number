#include<stdio.h>
#include<stdlib.h>
#include<math.h>
int* findDuplicates(int* nums, int numsSize, int* returnSize) {
    int* result = (int*)malloc((numsSize / 2 + 1) * sizeof(int));
    *returnSize = 0;
    for (int i = 0; i < numsSize; i++) {
        int val = abs(nums[i]);
        int index = val - 1;
        if (nums[index] < 0) {
            result[*returnSize] = val;
            (*returnSize)++;
        } else {
            nums[index] = -nums[index];
        }
    }
    return result;
}
