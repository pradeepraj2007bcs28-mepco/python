#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <ctype.h>
int calculate(char* s) {
    int len = strlen(s);
    int* stack = (int*)malloc(len * sizeof(int));
    int top = -1; 
    long long total = 0; 
    int sign = 1;        
    int i = 0;
    while (i < len) {
        char ch = s[i];
        if (isdigit(ch)) {
            long long num = 0;
            while (i < len && isdigit(s[i])) {
                num = num * 10 + (s[i] - '0');
                i++;
            }
            total += sign * num;
            continue; 
        } 
        else if (ch == '+') {
            sign = 1;
        } 
        else if (ch == '-') {
            sign = -1;
        } 
        else if (ch == '(') {
            stack[++top] = total;
            stack[++top] = sign;
                        total = 0;
            sign = 1;
        } 
        else if (ch == ')') {
            int prev_sign = stack[top--];
            long long prev_total = stack[top--];
                        total = prev_total + (prev_sign * total);
        }
        i++;
    }
        free(stack);
    return (int)total;
}
